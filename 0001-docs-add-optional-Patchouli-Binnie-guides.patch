+{
+  "name": "Inoculator & Splicer",
+  "category": "forestry:binnie_genetics",
+  "icon": "binniegenetics:inoculator",
+  "sortnum": 4,
+  "pages": [
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniegenetics:machine_inoculator",
+      "text": "(Temporary LLM text) The Inoculator applies serum genes to a compatible individual. It is slow, consumes Bacteria Vector, and is designed as the reliable application route."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniegenetics:machine_splicer",
