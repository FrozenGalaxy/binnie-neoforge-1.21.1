From 9e105e477462e2271172c7f31f7f7d0a5f14c1cc Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Thu, 13 Aug 2026 22:19:47 +0000
Subject: [PATCH 6/6] fix: move Ponder GUI previews to the left

---
 .../binnie/core/client/ponder/BinniePonderScenes.java     | 8 ++++----
 .../binnie/genetics/client/GeneticsPonderGuiPreview.java  | 4 ++--
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
index 1f51955..0044dd1 100644
--- a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
@@ -521,10 +521,10 @@ public final class BinniePonderScenes {
     }
 
     private static void text(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, int duration, String text) {
-        // Stock Ponder narrative text is horizontally biased to the right, exactly
-        // where the Genetics GUI preview lives. Keep the GUI on the right and put
-        // Binnie's narrative beats on the opposite side instead.
-        LeftPonderTextElement.show(scene, util.vector().topOf(pos), duration, text);
+        scene.overlay().showText(duration)
+                .placeNearTarget()
+                .text(text)
+                .pointAt(util.vector().topOf(pos));
     }
 
     private static BlockPos machinePos(SceneBuildingUtil util) {
diff --git a/src/main/java/binnie/genetics/client/GeneticsPonderGuiPreview.java b/src/main/java/binnie/genetics/client/GeneticsPonderGuiPreview.java
index fec2d47..c4fd39b 100644
--- a/src/main/java/binnie/genetics/client/GeneticsPonderGuiPreview.java
+++ b/src/main/java/binnie/genetics/client/GeneticsPonderGuiPreview.java
@@ -71,8 +71,8 @@ public final class GeneticsPonderGuiPreview {
             float scale = Math.min(0.72F, Math.min(260.0F / originalWidth, 155.0F / originalHeight));
             int renderedWidth = Math.round(originalWidth * scale);
             int renderedHeight = Math.round(originalHeight * scale);
-            int x = screen.width - renderedWidth - 24;
-            int y = Math.max(52, screen.height - renderedHeight - 88);
+            int x = 24;
+            int y = Math.max(64, screen.height - renderedHeight - 88);
 
             graphics.pose().pushPose();
             graphics.pose().translate(x, y, 700);
-- 
