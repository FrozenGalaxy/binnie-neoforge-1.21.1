diff --git a/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/bees/alveary_components.json b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/bees/alveary_components.json
new file mode 100644
index 0000000..723951a
--- /dev/null
+++ b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/bees/alveary_components.json
@@ -0,0 +1,48 @@
+{
+  "name": "Alveary Components",
+  "category": "forestry:binnie_bees",
+  "icon": "binniebees:alveary_mutator",
+  "sortnum": 1,
+  "pages": [
+    {
+      "type": "patchouli:text",
+      "text": "(Temporary LLM text) All seven Binnie Alveary components are structural replacements for Forestry Alveary blocks. Put them directly into a valid Alveary shell; they participate in the same multiblock and modify the colony hosted by it.",
+      "title": "Extending an Alveary"
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_mutator",
+      "text": "(Temporary LLM text) The Mutator consumes accepted mutagen items to multiply mutation chance, capped so the final mutation multiplier cannot grow without bound."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_frame",
+      "text": "(Temporary LLM text) The Frame Housing holds one hive frame and applies that frame’s bee modifiers to the Alveary colony. The frame wears as the colony works."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_rain_shield",
+      "text": "(Temporary LLM text) The Rain Shield seals the colony against rain, allowing rain-sensitive bees to continue working."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_lighting",
+      "text": "(Temporary LLM text) Alveary Lighting simulates sunlight for the colony, allowing normal daylight requirements to be satisfied at night."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_stimulator",
+      "text": "(Temporary LLM text) The Stimulator accepts a programmed Forestry circuit board carrying Binnie stimulator circuits. While supplied with FE, those circuit programs apply bee modifiers much like specialized powered frames."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_hatchery",
+      "text": "(Temporary LLM text) The Hatchery periodically creates larvae from the current queen while the Alveary is operating normally. It has internal slots for the larvae it collects."
+    },
+    {
+      "type": "patchouli:crafting",
+      "recipe": "binniebees:machine_alveary_transmission",
+      "text": "(Temporary LLM text) The Transmission accepts FE and distributes it among energy-using components in the same Alveary, including Binnie’s Stimulator and compatible Forestry components such as powered climate controls."
+    }
+  ]
+}
