diff --git a/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/breeding.json b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/breeding.json
new file mode 100644
index 0000000..5d25c59
--- /dev/null
+++ b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/breeding.json
@@ -0,0 +1,24 @@
+{
+  "name": "Breeding Flowers",
+  "category": "forestry:binnie_botany",
+  "icon": "binniebotany:pollen",
+  "sortnum": 2,
+  "pages": [
+    {
+      "type": "patchouli:text",
+      "text": "(Temporary LLM text) Place mature genetic flowers on appropriate Botany soil and use pollen from another flower to create a controlled cross. Offspring can inherit active and inactive alleles from both parents, and registered mutation pairs can produce a new species.",
+      "title": "Controlled crosses"
+    },
+    {
+      "type": "patchouli:text",
+      "text": "(Temporary LLM text) Mutation chance and colour inheritance are separate concerns. A successful species mutation may still carry unexpected colour or trait alleles, so analyse promising offspring before using them as the foundation of a longer breeding chain.",
+      "title": "Selecting offspring"
+    },
+    {
+      "type": "patchouli:spotlight",
+      "item": "binniebotany:botanist_database",
+      "text": "(Temporary LLM text) The Botanist Database is the natural companion to a breeding garden. It records discovered flower species and provides a durable reference as the number of possible crosses grows.",
+      "title": "Track discoveries"
+    }
+  ]
+}
diff --git a/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/flower_genetics.json b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/flower_genetics.json
new file mode 100644
index 0000000..081fbd7
--- /dev/null
+++ b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/flower_genetics.json
@@ -0,0 +1,25 @@
+{
+  "name": "Flower Genetics",
+  "category": "forestry:binnie_botany",
+  "icon": "binniebotany:flower",
+  "sortnum": 0,
+  "pages": [
+    {
+      "type": "patchouli:spotlight",
+      "item": "binniebotany:flower",
+      "text": "(Temporary LLM text) Botany flowers are true genetic organisms. A flower carries species and trait chromosomes, can be analysed, can produce pollen and seeds, and can create offspring whose genome reflects the parents and mutation rules.",
+      "title": "Genetic flowers"
+    },
+    {
+      "type": "patchouli:spotlight",
+      "item": "binniebotany:pollen",
+      "text": "(Temporary LLM text) Pollen carries genetic information from its source flower. Pollination combines parental genetics and is the main route to deliberate flower breeding and mutation discovery.",
+      "title": "Pollen and breeding"
+    },
+    {
+      "type": "patchouli:text",
+      "text": "(Temporary LLM text) Flowers have substantially more state than a decorative vanilla flower: generation, age, flowering and wilting state, colour genetics, fertility, and other chromosomes all matter. Use the field and database tools rather than judging a plant only by its visible colour.",
+      "title": "Reading a flower"
+    }
+  ]
+}
diff --git a/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/soil_gardening.json b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/botany/soil_gardening.json
