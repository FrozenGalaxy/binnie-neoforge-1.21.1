@@ -0,0 +1,25 @@
+{
+  "name": "Soil & Gardening",
+  "category": "forestry:binnie_botany",
+  "icon": "binniebotany:soil_meter",
+  "sortnum": 1,
+  "pages": [
+    {
+      "type": "patchouli:spotlight",
+      "item": "binniebotany:soil_meter",
+      "text": "(Temporary LLM text) The Soil Meter reports moisture, pH, fertility, and weedkiller state for Botany soil. These properties affect which garden conditions are being maintained and can be changed with gardening reagents.",
+      "title": "Inspecting soil"
+    },
+    {
+      "type": "patchouli:spotlight",
+      "item": "binniebotany:fertiliser",
+      "text": "(Temporary LLM text) Nutrient fertilisers improve soil quality, acidic treatments move pH toward acidic, alkaline treatments move pH toward alkaline, and Weedkiller prevents weed growth on treated soil.",
+      "title": "Changing soil"
+    },
+    {
+      "type": "patchouli:text",
+      "text": "(Temporary LLM text) Soil, Loam, and Flowerbed are related but distinct quality families. Moisture and acidity are independent properties, so a visually similar plot can still be unsuitable for the breeding setup you intended.",
+      "title": "Soil state"
+    }
+  ]
+}
