     /**
-     * Give every machine GUI the same deliberate inspection beat. A keyframe is
-     * placed immediately before it so the native Ponder timeline can seek directly
-     * to the preview. Native Ponder overlay durations do not include their five-tick
-     * fade-in and fade-out tails, so wait for the complete lifetime before continuing.
+     * Pair the real machine GUI with the machine's main explanation. The text and
+     * preview share one keyframed beat and the same lifetime, so the GUI is something
+     * to inspect while reading rather than a silent chapter of its own.
      */
-    private static void showMachineGui(SceneBuilder scene, ResourceLocation machineId, GeneticsJeiRecipe recipe) {
-        scene.idle(25);
-        scene.addKeyframe();
-        GeneticsPonderGuiPreview.show(scene, machineId, recipe, MACHINE_GUI_PREVIEW_TICKS);
-        scene.idle(MACHINE_GUI_PREVIEW_TICKS + OVERLAY_SEPARATION_TICKS);
+    private static void machineExplanation(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos,
+                                           ResourceLocation machineId, GeneticsJeiRecipe recipe, String text) {
+        scene.overlay().showText(MACHINE_EXPLANATION_TICKS)
+                .placeNearTarget()
+                .text(text)
+                .pointAt(util.vector().topOf(pos))
+                .attachKeyFrame();
+        GeneticsPonderGuiPreview.show(scene, machineId, recipe, MACHINE_EXPLANATION_TICKS);
+        scene.idle(MACHINE_EXPLANATION_TICKS + OVERLAY_SEPARATION_TICKS);
     }
 
     private static void moveThroughStation(SceneBuilder scene, SceneBuildingUtil util, ItemStack inputStack, ItemStack output) {
