--- /dev/null
+++ b/src/main/java/binnie/core/client/ponder/LeftPonderTextElement.java
@@ -0,0 +1,133 @@
+package binnie.core.client.ponder;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.createmod.catnip.data.Couple;
+import net.createmod.catnip.gui.element.BoxElement;
+import net.createmod.catnip.theme.Color;
+import net.createmod.ponder.api.PonderPalette;
+import net.createmod.ponder.api.scene.SceneBuilder;
+import net.createmod.ponder.foundation.PonderScene;
+import net.createmod.ponder.foundation.PonderScene.SceneTransform;
+import net.createmod.ponder.foundation.element.AnimatedOverlayElementBase;
+import net.createmod.ponder.foundation.instruction.FadeInOutInstruction;
+import net.createmod.ponder.foundation.ui.PonderUI;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.network.chat.FormattedText;
+import net.minecraft.network.chat.Style;
+import net.minecraft.world.phys.Vec2;
+import net.minecraft.world.phys.Vec3;
+
+import java.util.List;
+import java.util.function.Supplier;
+
+/**
+ * Native-looking Ponder text window anchored to the left side of the screen.
+ *
+ * <p>Ponder's stock {@code TextWindowElement} intentionally computes its X position
+ * in the right-hand portion of the screen and exposes no horizontal-position API.
+ * Genetics GUI previews deliberately occupy that same area, so Binnie uses this
+ * small mirror of the stock renderer for narrative beats while retaining Ponder's
+ * normal translation registration, fade timing and pointer-line presentation.</p>
+ */
+public final class LeftPonderTextElement extends AnimatedOverlayElementBase {
+    private static final Couple<Color> COLOR_WINDOW_BORDER = Couple.create(
+            new Color(0x607a6000, true),
+            new Color(0x207a6000, true)
+    ).map(Color::setImmutable);
+
+    private static final int LEFT_MARGIN = 24;
+    private static final int MAX_TEXT_WIDTH = 190;
+
+    private final Supplier<String> textGetter;
+    private final Vec3 target;
+    private String bakedText;
+
+    private LeftPonderTextElement(Supplier<String> textGetter, Vec3 target) {
+        this.textGetter = textGetter;
+        this.target = target;
+    }
+
+    public static void show(SceneBuilder scene, Vec3 target, int duration, String defaultText) {
+        // Use the same per-scene translation registration as TextWindowElement.Builder#text.
+        LeftPonderTextElement element = new LeftPonderTextElement(
+                scene.getScene().registerText(defaultText), target);
+
+        scene.addInstruction(new FadeInOutInstruction(duration) {
+            @Override
+            protected void show(PonderScene ponderScene) {
+                ponderScene.addElement(element);
+                element.setVisible(true);
+            }
+
+            @Override
+            protected void hide(PonderScene ponderScene) {
+                element.setVisible(false);
+            }
+
+            @Override
+            protected void applyFade(PonderScene ponderScene, float fade) {
+                element.setFade(fade);
+            }
+        });
+        scene.addLazyKeyframe();
+    }
+
+    @Override
+    public void render(PonderScene scene, PonderUI screen, GuiGraphics graphics, float partialTicks, float fade) {
+        if (bakedText == null) bakedText = textGetter.get();
+        if (fade < 1.0F / 16.0F) return;
+
+        SceneTransform transform = scene.getTransform();
+        Vec2 sceneToScreen = transform.sceneToScreen(target, partialTicks);
+        boolean settled = transform.xRotation.settled() && transform.yRotation.settled();
+        float pY = settled ? (int) sceneToScreen.y : sceneToScreen.y;
+
+        int availableWidth = Math.max(80, (int) sceneToScreen.x - LEFT_MARGIN - 35);
+        int textWidth = Math.min(MAX_TEXT_WIDTH, availableWidth);
+        List<FormattedText> lines = screen.getFontRenderer().getSplitter()
+                .splitLines(bakedText, textWidth, Style.EMPTY);
+
+        int boxWidth = 0;
+        for (FormattedText line : lines) {
+            boxWidth = Math.max(boxWidth, screen.getFontRenderer().width(line));
+        }
+        int boxHeight = screen.getFontRenderer().wordWrapHeight(bakedText, Math.max(1, boxWidth));
+        int boxX = LEFT_MARGIN;
+
+        PoseStack poseStack = graphics.pose();
+        poseStack.pushPose();
+        poseStack.translate(0, pY, 400);
+
+        new BoxElement()
+                .withBackground(PonderUI.BACKGROUND_FLAT)
+                .gradientBorder(COLOR_WINDOW_BORDER)
+                .at(boxX, 3, -101)
+                .withBounds(boxWidth, boxHeight - 1)
+                .render(graphics);
+
+        Color brighter = PonderPalette.WHITE.getColorObject()
+                .mixWith(new Color(0xff_ffffdd), 0.5f)
+                .setImmutable();
+        Color c1 = new Color(0xff_494949);
+        Color c2 = new Color(0xff_393939);
+
+        // Mirror the stock horizontal pointer line: text is on the left, target is in the scene.
+        float lineStart = boxX + boxWidth + 10;
+        if (sceneToScreen.x > lineStart) {
+            poseStack.pushPose();
+            poseStack.translate(lineStart, 0, 0);
+            double lineTarget = (sceneToScreen.x - lineStart) * fade;
+            poseStack.scale((float) lineTarget, 1, 1);
+            graphics.fillGradient(0, 0, 1, 1, -100, brighter.getRGB(), brighter.getRGB());
+            graphics.fillGradient(0, 1, 1, 2, -100, c1.getRGB(), c2.getRGB());
+            poseStack.popPose();
+        }
+
+        poseStack.translate(0, 0, 400);
+        for (int i = 0; i < lines.size(); i++) {
+            graphics.drawString(screen.getFontRenderer(), lines.get(i).getString(), boxX,
+                    3 + 9 * i, brighter.scaleAlphaForText(fade).getRGB(), false);
+        }
+        poseStack.popPose();
+    }
+}
