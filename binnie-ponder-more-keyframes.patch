From 58e0f9cd583b86edbb32309ad7b6d38cd367122a Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Thu, 13 Aug 2026 23:04:12 +0000
Subject: [PATCH] fix: add finer Ponder timeline keyframes

---
 .../java/binnie/core/client/ponder/BinniePonderScenes.java  | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
index 7497bab..cb89ae6 100644
--- a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
@@ -484,14 +484,20 @@ public final class BinniePonderScenes {
         scene.effects().indicateSuccess(machine);
         scene.idle(8);
         if (!output.isEmpty()) {
+            scene.addKeyframe();
             scene.overlay().showControls(util.vector().topOf(result), Pointing.DOWN, 28).withItem(output);
         }
     }
 
     /** Show one item at a time, including a clean frame after the previous fade-out. */
     private static void showInputs(SceneBuilder scene, SceneBuildingUtil util, BlockPos machine, ItemStack... inputs) {
+        boolean keyframed = false;
         for (ItemStack input : inputs) {
             if (input.isEmpty()) continue;
+            if (!keyframed) {
+                scene.addKeyframe();
+                keyframed = true;
+            }
             scene.overlay().showControls(util.vector().topOf(machine).add(0, 0.3, 0), Pointing.DOWN, ITEM_CALLOUT_TICKS)
                     .withItem(input);
             scene.idle(ITEM_CALLOUT_TICKS + OVERLAY_SEPARATION_TICKS);
