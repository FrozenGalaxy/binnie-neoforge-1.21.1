From: OpenAI <noreply@openai.com>
Date: Thu, 13 Aug 2026 21:57:35 +0000
Subject: [PATCH 4/4] fix: separate Ponder overlay fade tails

---
 .../client/ponder/BinniePonderScenes.java     | 32 +++++++++++++------
 1 file changed, 23 insertions(+), 9 deletions(-)

diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
index a7bb315..5571443 100644
--- a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
@@ -27,6 +27,13 @@ import java.util.Map;
 
 /** Ponder scenes for Binnie's systems, paced and staged after Create's own scenes. */
 public final class BinniePonderScenes {
+    // Native Ponder FadeInOutInstruction adds five ticks on both ends of the requested
+    // duration. Leave one extra tick after that full lifetime before starting another
+    // overlay in the same visual lane, otherwise their fade tails briefly coexist.
+    private static final int OVERLAY_FADE_TICKS = 5;
+    private static final int OVERLAY_SEPARATION_TICKS = OVERLAY_FADE_TICKS * 2 + 1;
+    private static final int ITEM_CALLOUT_TICKS = 18;
+
     private BinniePonderScenes() {
     }
 
@@ -423,9 +430,10 @@ public final class BinniePonderScenes {
                 "Offspring are produced as genetic seeds. Their genomes combine the parents and can contain new inherited traits or mutations, so grow and select the offspring you want to continue breeding.");
         scene.idle(70);
 
-        scene.overlay().showControls(util.vector().topOf(child), Pointing.DOWN, 24)
+        int soilMeterCalloutTicks = 24;
+        scene.overlay().showControls(util.vector().topOf(child), Pointing.DOWN, soilMeterCalloutTicks)
                 .rightClick().withItem(item("binniebotany", "soil_meter"));
-        scene.idle(28);
+        scene.idle(soilMeterCalloutTicks + OVERLAY_SEPARATION_TICKS);
         controls(scene, util, util.grid().at(2, 1, 6), new ItemStack(Items.WATER_BUCKET));
         scene.idle(34);
         controls(scene, util, child, item("binniebotany", "acid_fertiliser"));
@@ -455,11 +463,16 @@ public final class BinniePonderScenes {
         scene.idle(8);
     }
 
-    /** Keep the right-side GUI preview on its own beat. Ponder's stock near-target text also prefers the right side. */
+    /**
+     * Keep the right-side GUI preview on a strictly exclusive beat. Native Ponder
+     * overlay durations do not include their 5-tick fade-in and fade-out tails, so
+     * wait for the complete lifetime before the next story text is created.
+     */
     private static void showMachineGui(SceneBuilder scene, ResourceLocation machineId, GeneticsJeiRecipe recipe) {
+        int duration = 55;
         scene.idle(25);
-        GeneticsPonderGuiPreview.show(scene, machineId, recipe, 55);
-        scene.idle(60);
+        GeneticsPonderGuiPreview.show(scene, machineId, recipe, duration);
+        scene.idle(duration + OVERLAY_SEPARATION_TICKS);
     }
 
     private static void moveThroughStation(SceneBuilder scene, SceneBuildingUtil util, ItemStack inputStack, ItemStack output) {
@@ -479,13 +492,13 @@ public final class BinniePonderScenes {
         }
     }
 
-    /** Show one item at a time so Ponder's control callouts never overlap or z-fight. */
+    /** Show one item at a time, including a clean frame after the previous fade-out. */
     private static void showInputs(SceneBuilder scene, SceneBuildingUtil util, BlockPos machine, ItemStack... inputs) {
         for (ItemStack input : inputs) {
             if (input.isEmpty()) continue;
-            scene.overlay().showControls(util.vector().topOf(machine).add(0, 0.3, 0), Pointing.DOWN, 18)
+            scene.overlay().showControls(util.vector().topOf(machine).add(0, 0.3, 0), Pointing.DOWN, ITEM_CALLOUT_TICKS)
                     .withItem(input);
-            scene.idle(22);
+            scene.idle(ITEM_CALLOUT_TICKS + OVERLAY_SEPARATION_TICKS);
         }
     }
 
@@ -503,7 +516,8 @@ public final class BinniePonderScenes {
     }
 
     private static void controls(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, ItemStack stack) {
-        if (!stack.isEmpty()) scene.overlay().showControls(util.vector().topOf(pos), Pointing.DOWN, 32).withItem(stack);
+        if (!stack.isEmpty())
+            scene.overlay().showControls(util.vector().topOf(pos), Pointing.DOWN, ITEM_CALLOUT_TICKS).withItem(stack);
     }
 
     private static void text(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, int duration, String text) {
