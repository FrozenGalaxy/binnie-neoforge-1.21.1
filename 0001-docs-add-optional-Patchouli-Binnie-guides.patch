diff --git a/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/genetics/laboratory_overview.json b/src/main/resources/assets/forestry/patchouli_books/foresters_manual/en_us/entries/binnie/genetics/laboratory_overview.json
