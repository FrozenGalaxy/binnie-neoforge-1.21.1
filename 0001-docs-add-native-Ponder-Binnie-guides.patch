diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderCompat.java b/src/main/java/binnie/core/client/ponder/BinniePonderCompat.java
new file mode 100644
index 0000000..189ac80
--- /dev/null
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderCompat.java
@@ -0,0 +1,18 @@
+package binnie.core.client.ponder;
+
+import net.createmod.ponder.foundation.PonderIndex;
+
+/** Client-only bridge kept behind a mod-presence check so Ponder remains optional. */
+public final class BinniePonderCompat {
+    private static boolean registered;
+
+    private BinniePonderCompat() {
+    }
+
+    public static void register() {
+        if (!registered) {
+            PonderIndex.addPlugin(new BinniePonderPlugin());
+            registered = true;
+        }
+    }
+}
diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderPlugin.java b/src/main/java/binnie/core/client/ponder/BinniePonderPlugin.java
new file mode 100644
index 0000000..bdc6b4c
--- /dev/null
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderPlugin.java
@@ -0,0 +1,18 @@
+package binnie.core.client.ponder;
+
+import binnie.core.BinnieCore;
+import net.createmod.ponder.api.registration.PonderPlugin;
+import net.createmod.ponder.api.registration.PonderSceneRegistrationHelper;
+import net.minecraft.resources.ResourceLocation;
+
+public final class BinniePonderPlugin implements PonderPlugin {
+    @Override
+    public String getModId() {
+        return BinnieCore.MOD_ID;
+    }
+
+    @Override
+    public void registerScenes(PonderSceneRegistrationHelper<ResourceLocation> helper) {
+        BinniePonderScenes.register(helper);
+    }
+}
diff --git a/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
new file mode 100644
index 0000000..9e5eaa8
--- /dev/null
+++ b/src/main/java/binnie/core/client/ponder/BinniePonderScenes.java
@@ -0,0 +1,206 @@
+package binnie.core.client.ponder;
+
+import net.createmod.ponder.api.PonderPalette;
+import net.createmod.ponder.api.registration.PonderSceneRegistrationHelper;
+import net.createmod.ponder.api.scene.SceneBuilder;
+import net.createmod.ponder.api.scene.SceneBuildingUtil;
+import net.createmod.ponder.api.scene.Selection;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.phys.Vec3;
+
+public final class BinniePonderScenes {
+    private BinniePonderScenes() {
+    }
+
+    public static void register(PonderSceneRegistrationHelper<ResourceLocation> helper) {
+        helper.forComponents(
+                id("binniegenetics", "isolator"), id("binniegenetics", "sequencer"),
+                id("binniegenetics", "polymeriser"), id("binniegenetics", "inoculator"),
+                id("binniegenetics", "splicer"), id("binniegenetics", "analyser"),
+                id("binniegenetics", "genepool"))
+                .addStoryBoard("genetics_pipeline", BinniePonderScenes::geneticsPipeline);
+
+        helper.forComponents(
+                id("binniebees", "alveary_mutator"), id("binniebees", "alveary_frame"),
+                id("binniebees", "alveary_rain_shield"), id("binniebees", "alveary_lighting"),
+                id("binniebees", "alveary_stimulator"), id("binniebees", "alveary_hatchery"),
+                id("binniebees", "alveary_transmission"))
+                .addStoryBoard("alveary_components", BinniePonderScenes::alvearyComponents);
+
+        helper.forComponents(
+                id("binniebotany", "flower"), id("binniebotany", "pollen"),
+                id("binniebotany", "seed"), id("binniebotany", "soil_meter"))
+                .addStoryBoard("botany_breeding", BinniePonderScenes::botanyBreeding);
+    }
+
+    public static void geneticsPipeline(SceneBuilder scene, SceneBuildingUtil util) {
+        scene.title("genetics_pipeline", "From organism to usable genetics");
+        scene.configureBasePlate(0, 0, 9);
+        scene.showBasePlate();
+        scene.scaleSceneView(0.72f);
+        scene.idle(10);
+
+        BlockPos isolator = util.grid().at(1, 1, 2);
+        BlockPos sequencer = util.grid().at(3, 1, 2);
+        BlockPos polymeriser = util.grid().at(5, 1, 2);
+        BlockPos inoculator = util.grid().at(7, 1, 2);
+        BlockPos analyser = util.grid().at(3, 1, 5);
+        BlockPos genepool = util.grid().at(5, 1, 5);
+        BlockPos splicer = util.grid().at(7, 1, 5);
+
+        place(scene, util, isolator, "binniegenetics", "isolator");
+        place(scene, util, sequencer, "binniegenetics", "sequencer");
+        place(scene, util, polymeriser, "binniegenetics", "polymeriser");
+        place(scene, util, inoculator, "binniegenetics", "inoculator");
+        place(scene, util, analyser, "binniegenetics", "analyser");
+        place(scene, util, genepool, "binniegenetics", "genepool");
+        place(scene, util, splicer, "binniegenetics", "splicer");
+        scene.idle(15);
+
+        text(scene, util, isolator, 70,
+                "The Isolator samples one active or inactive allele from a genetic individual. Empty Sequencers, enzyme and ethanol support the extraction.");
+        drop(scene, util, isolator, "binniegenetics", "empty_sequencer");
+        scene.idle(75);
+
+        text(scene, util, sequencer, 65,
+                "The Sequencer turns that unsequenced sample into identified genetic material. Fluorescent Dye is consumed as sequencing progresses.");
+        drop(scene, util, sequencer, "binniegenetics", "fluorescent_dye");
+        scene.idle(70);
+
+        text(scene, util, polymeriser, 70,
+                "The Polymeriser charges a serum or serum array with Raw DNA. A charged serum can then be used to change an organism's genome.");
+        drop(scene, util, polymeriser, "binniegenetics", "genetic_material");
+        scene.idle(75);
+
+        text(scene, util, inoculator, 65,
+                "The Inoculator is the deliberate route: apply the selected serum genes to an individual using Vector Bacteria.");
+        scene.idle(70);
+        text(scene, util, splicer, 65,
+                "The Splicer is the high-throughput alternative for serum arrays. It works much faster, but demands substantially more power.");
+        scene.idle(70);
+
+        scene.rotateCameraY(35);
+        text(scene, util, analyser, 65,
+                "The Analyser reveals hidden genetic information, while your genetic databases retain discoveries made by laboratory work.");
+        scene.idle(70);
+        text(scene, util, genepool, 65,
+                "The Gene Pool is the destructive branch: sacrifice an individual when what you need is Raw DNA rather than its intact genome.");
+        scene.idle(70);
+        scene.markAsFinished();
+    }
+
+    public static void alvearyComponents(SceneBuilder scene, SceneBuildingUtil util) {
+        scene.title("alveary_components", "Specialising a Forestry Alveary");
+        scene.configureBasePlate(0, 0, 9);
+        scene.showBasePlate();
+        scene.scaleSceneView(0.72f);
+        scene.idle(10);
+
+        Selection cube = util.select().fromTo(3, 1, 3, 5, 3, 5);
+        Selection cap = util.select().fromTo(3, 4, 3, 5, 4, 5);
+        scene.world().setBlocks(cube, block("forestry", "alveary_block").defaultBlockState(), false);
+        scene.world().setBlocks(cap, net.minecraft.world.level.block.Blocks.OAK_SLAB.defaultBlockState(), false);
+        scene.world().showSection(cube, Direction.DOWN);
+        scene.world().showSection(cap, Direction.DOWN);
+        scene.idle(20);
+
+        BlockPos slot = util.grid().at(4, 2, 3);
+        text(scene, util, slot, 60,
+                "Binnie's Alveary blocks replace ordinary wall blocks. Each one specialises the completed Forestry multiblock without changing its footprint.");
+        scene.idle(65);
+
+        component(scene, util, slot, "alveary_mutator", 55,
+                "The Mutator consumes mutagen items and multiplies mutation chance, with the final modifier capped rather than growing without limit.");
+        component(scene, util, slot, "alveary_frame", 55,
+                "The Frame Housing contributes the modifier of one Forestry hive frame and wears that frame while the Alveary runs.");
+        component(scene, util, slot, "alveary_rain_shield", 50,
+                "The Rain Shield seals the Alveary so rain-sensitive bees can keep working through bad weather.");
+        component(scene, util, slot, "alveary_lighting", 50,
+                "The Lighting block supplies artificial daylight for species that would otherwise stop when they cannot see the sky.");
+        component(scene, util, slot, "alveary_stimulator", 60,
+                "The Stimulator accepts a compatible circuit board and applies its configured bee modifiers while the block is powered.");
+        component(scene, util, slot, "alveary_hatchery", 55,
+                "The Hatchery occasionally produces larvae from a healthy working queen and keeps the results in its internal inventory.");
+        component(scene, util, slot, "alveary_transmission", 60,
+                "The Transmission block accepts FE and distributes it to Alveary components that need energy, giving powered upgrades a shared supply point.");
+        scene.markAsFinished();
+    }
+
+    public static void botanyBreeding(SceneBuilder scene, SceneBuildingUtil util) {
+        scene.title("botany_breeding", "Breeding Binnie's genetic flowers");
+        scene.configureBasePlate(0, 0, 7);
+        scene.showBasePlate();
+        scene.scaleSceneView(0.82f);
+        scene.idle(10);
+
+        BlockPos leftSoil = util.grid().at(2, 1, 3);
+        BlockPos rightSoil = util.grid().at(4, 1, 3);
+        BlockPos childSoil = util.grid().at(3, 1, 5);
+        scene.world().setBlock(leftSoil, block("binniebotany", "flowerbed").defaultBlockState(), false);
+        scene.world().setBlock(rightSoil, block("binniebotany", "flowerbed").defaultBlockState(), false);
+        scene.world().setBlock(childSoil, block("binniebotany", "flowerbed").defaultBlockState(), false);
+        scene.world().showSection(util.select().fromTo(2, 1, 3, 4, 1, 5), Direction.DOWN);
+        scene.idle(15);
+
+        drop(scene, util, leftSoil.above(), "binniebotany", "flower");
+        drop(scene, util, rightSoil.above(), "binniebotany", "flower");
+        text(scene, util, leftSoil, 65,
+                "Binnie's flowers are genetic organisms. Two flowers can look similar while carrying different active and inactive alleles.");
+        scene.idle(70);
+
+        drop(scene, util, util.grid().at(3, 2, 3), "binniebotany", "pollen");
+        text(scene, util, util.grid().at(3, 1, 3), 65,
+                "Pollen carries a flower genome. Pollination combines parent genetics, allowing inherited traits and mutations to appear in the offspring.");
+        scene.idle(70);
+
+        drop(scene, util, childSoil.above(), "binniebotany", "seed");
+        text(scene, util, childSoil, 65,
+                "The result is a genetic seed. Grow and analyse promising offspring, then keep breeding toward the traits and colours you want.");
+        scene.idle(70);
+
+        drop(scene, util, util.grid().at(1, 2, 5), "binniebotany", "soil_meter");
+        text(scene, util, childSoil, 70,
+                "Flowerbeds also track moisture, acidity, fertility and weedkiller. The Soil Meter lets you inspect those conditions instead of guessing what a plant needs.");
+        scene.idle(75);
+        scene.markAsFinished();
+    }
+
+    private static void component(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, String id, int duration,
+                                  String description) {
+        scene.world().setBlock(pos, block("binniebees", id).defaultBlockState(), true);
+        scene.overlay().showOutlineWithText(util.select().position(pos), duration)
+                .colored(PonderPalette.GREEN)
+                .text(description);
+        scene.idle(duration + 5);
+    }
+
+    private static void place(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, String namespace, String path) {
+        scene.world().setBlock(pos, block(namespace, path).defaultBlockState(), false);
+        scene.world().showSection(util.select().position(pos), Direction.DOWN);
+    }
+
+    private static void text(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, int duration, String text) {
+        scene.overlay().showText(duration).text(text).pointAt(util.vector().topOf(pos));
+    }
+
+    private static void drop(SceneBuilder scene, SceneBuildingUtil util, BlockPos pos, String namespace, String path) {
+        ItemStack stack = new ItemStack(BuiltInRegistries.ITEM.get(id(namespace, path)));
+        if (!stack.isEmpty()) {
+            Vec3 location = util.vector().centerOf(pos).add(0, 0.45, 0);
+            scene.world().createItemEntity(location, Vec3.ZERO, stack);
+        }
+    }
+
+    private static Block block(String namespace, String path) {
+        return BuiltInRegistries.BLOCK.get(id(namespace, path));
+    }
+
+    private static ResourceLocation id(String namespace, String path) {
+        return ResourceLocation.fromNamespaceAndPath(namespace, path);
+    }
+}
